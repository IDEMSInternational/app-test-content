{
  "flow_type": "template",
  "flow_name": "test_dynamic_variable_refs",
  "status": "released",
  "rows": [
    {
      "type": "text",
      "value": "# Dynamic Variable References"
    },
    {
      "type": "set_variable ",
      "name": "questions",
      "value": "[{key: \"key_1\", value: \"Question 1\"}, \n{key: \"key_2\", value: \"Question 2\"},  \n{key: \"key_3\", value: \"Question 3\"}]",
      "parameter_list": "value_type: list;"
    },
    {
      "type": "begin_loop",
      "name": "question_loop",
      "value": "local.questions",
      "parameter_list": "index: key;"
    },
    {
      "type": "text",
      "name": "question",
      "value": "${item.value}"
    },
    {
      "type": "text_box",
      "name": "answer",
      "parameter_list": "placeholder: Answer;"
    },
    {
      "type": "end_loop"
    },
    {
      "type": "begin_loop",
      "name": "answer_loop",
      "value": "local.questions",
      "parameter_list": "index: key;"
    },
    {
      "type": "text",
      "name": "the_question",
      "value": "local.question_loop[item.key].question",
      "parameter_list": "value_type: script;"
    },
    {
      "type": "text",
      "name": "the_answer",
      "value": "local.question_loop[item.key].answer",
      "parameter_list": "value_type: script;"
    },
    {
      "type": "end_loop"
    }
  ]
}